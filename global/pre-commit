#!/usr/bin/env bash
# GLOBAL pre-commit (installed at ~/.config/git/hooks via git config --global core.hooksPath).
# Runs in every repo that does NOT set its own core.hooksPath. Two jobs:
#   1. enforce the promotion drift gate (clybor-claude-tooling)
#   2. NOT bypass a repo's own default .git/hooks/pre-commit (core.hooksPath shadows it)
# Repos with their own core.hooksPath (e.g. clybor-tooling projects, husky) override this entirely;
# those run their local .githooks/pre-commit, which itself calls the promotion gate.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
CANON="${CLYBOR_TOOLING:-$HOME/gits/clybor-claude-tooling}"

# HARD GATE: committing INTO the public canonical repo must pass the agnostic scan of the
# full staged diff (client names via denylist + PII regex). This is the gate that makes a
# leak into clybor-tooling impossible — not honor-system, not assets/-only.
if [ "$(cd "$CANON" 2>/dev/null && pwd)" = "$ROOT" ] && [ -f "$ROOT/scripts/verify-clean.py" ]; then
  if ! python3 "$ROOT/scripts/verify-clean.py" --staged; then
    echo "BLOCKED: staged content failed the public-repo agnostic gate (clybor-claude-tooling)." >&2
    exit 1
  fi
fi

# Non-blocking nudge: surface drift/candidates but never block an arbitrary repo's commit
# (avoids false blocks on filename collisions in repos that aren't clybor-tooling-managed).
# Hard blocking lives in managed projects' own .githooks/pre-commit (--gate, full tree).
if [ -x "$CANON/scripts/check-promotion.sh" ]; then
  bash "$CANON/scripts/check-promotion.sh" --surface || true
fi

# no-postmortem doc gate: block tombstone/post-mortem prose in operational
# .claude/*.md. No-op in repos without the hook or without such docs.
if [ -f "$ROOT/.claude/hooks/no-postmortem-precommit.py" ]; then
  python3 "$ROOT/.claude/hooks/no-postmortem-precommit.py" || exit 1
fi

# preserve the repo's own default hook (not auto-run while core.hooksPath is set globally)
if [ -x "$ROOT/.git/hooks/pre-commit" ]; then exec "$ROOT/.git/hooks/pre-commit"; fi
exit 0
