#!/usr/bin/env bash
# Repo pre-commit gate. Enable once with: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
CANON="${CLYBOR_TOOLING:-$HOME/gits/clybor-claude-tooling}"

# A gate guarded by `[ -f <script> ]` is a no-op when the script is absent, and a silent no-op
# reads exactly like a pass. Measured 2026-09-18: the PHI gate below was wired but its scanner
# did not exist, so a file carrying eleven client identifiers was committed under a hook that
# printed success. Absence is now announced. Do not add a gate without a matching skip notice.
skipped=()
trap report_skips EXIT
report_skips() {
  if [ "${#skipped[@]}" -gt 0 ]; then
    echo "" >&2
    echo "⚠ pre-commit gates NOT RUN (script absent):" >&2
    for s in "${skipped[@]}"; do echo "    - $s" >&2; done
    echo "  These checked nothing. That is not the same as passing." >&2
  fi
}

# Detect absent gates BEFORE running any of them. Gates exit on first failure, so an inline
# else-branch on gate 6 never fires when gate 2 fails — the skip notice has to be built up
# front or it is only correct on the happy path.
[ -x "$ROOT/scripts/check-knowledge.sh" ]                   || skipped+=("knowledge invariants (scripts/check-knowledge.sh)")
[ -x "$CANON/scripts/check-promotion.sh" ]                  || skipped+=("tooling drift ($CANON/scripts/check-promotion.sh)")
[ -f "$ROOT/.claude/hooks/no-postmortem-precommit.py" ]     || skipped+=("no-postmortem doc gate")
[ -f "$ROOT/scripts/check_dependency_probes.py" ]           || skipped+=("availability / dependency probes")
[ -f "$ROOT/scripts/check_tracker_version.py" ]             || skipped+=("tracker-staleness gate")
[ -f "$ROOT/scripts/phi-scan.py" ]                          || skipped+=("PHI / client-identifier gate (scripts/phi-scan.py)")
[ -f "$ROOT/scripts/check_house_style.py" ]                 || skipped+=("Cox house style gate (scripts/check_house_style.py)")
[ -f "$ROOT/scripts/check_hook_wiring.py" ]                  || skipped+=("hook wiring (scripts/check_hook_wiring.py)")

# 1. local knowledge-wiki / project-rule invariants
if [ -x "$ROOT/scripts/check-knowledge.sh" ]; then
  bash "$ROOT/scripts/check-knowledge.sh" || exit $?
fi
# 2. promotion drift gate vs clybor-claude-tooling
if [ -x "$CANON/scripts/check-promotion.sh" ]; then
  bash "$CANON/scripts/check-promotion.sh" --gate || exit $?
fi
# 3. no-postmortem doc gate (operational .claude/*.md)
if [ -f "$ROOT/.claude/hooks/no-postmortem-precommit.py" ]; then
  python3 "$ROOT/.claude/hooks/no-postmortem-precommit.py" || exit $?
fi
# 4. availability gate — every OPEN dependency owned by someone else must declare
#    [probed: …] / [decisional] / [NOT PROBED: …]. Override: PROBE_OK=1 git commit
if [ -f "$ROOT/scripts/check_dependency_probes.py" ] && [ -z "$PROBE_OK" ]; then
  python3 "$ROOT/scripts/check_dependency_probes.py" --staged || exit $?
fi
# 5. tracker-staleness gate — no live pointer may name a superseded tracker version.
#    Two hand sweeps on 2026-08-18 both missed surfaces; this is the codified version.
#    Override: TRACKER_OK=1 git commit
if [ -f "$ROOT/scripts/check_tracker_version.py" ] && [ -z "$TRACKER_OK" ]; then
  python3 "$ROOT/scripts/check_tracker_version.py" --staged --quiet || exit $?
fi
# 6. PHI gate — refuse a commit that stages client documents or identifiers.
#    No-ops in repos without the scanner. Needs a client-name list outside git.
if [ -f "$ROOT/scripts/phi-scan.py" ]; then
  python3 "$ROOT/scripts/phi-scan.py" --staged || exit $?
fi
# 7. Cox house style gate — a staged Content Studio draft must pass the twelve rules Cox stated
#    on 2026-09-16. Both packs written on 2026-09-18 broke rules encoded hours earlier, caught
#    by an ad-hoc regex rather than any gate. Override: HOUSE_STYLE_OK=1 git commit
if [ -f "$ROOT/scripts/check_house_style.py" ] && [ -z "$HOUSE_STYLE_OK" ]; then
  python3 "$ROOT/scripts/check_house_style.py" --staged || exit $?
fi
# 8. Hook wiring -- every configured hook must name a script that exists, so a hook that
#    would error into a void is caught here rather than at the next session.
#    Override: HOOK_WIRING_OK=1 git commit
if [ -f "$ROOT/scripts/check_hook_wiring.py" ] && [ -z "$HOOK_WIRING_OK" ]; then
  python3 "$ROOT/scripts/check_hook_wiring.py" --quiet || exit $?
fi
exit 0
