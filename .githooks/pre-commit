#!/usr/bin/env bash
# Repo pre-commit gate. Enable once with: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
CANON="${CLYBOR_TOOLING:-$HOME/gits/clybor-claude-tooling}"
# 1. local knowledge-wiki / project-rule invariants
if [ -x "$ROOT/scripts/check-knowledge.sh" ]; then
  bash "$ROOT/scripts/check-knowledge.sh" || exit $?
fi
# 2. promotion drift gate vs clybor-claude-tooling
if [ -x "$CANON/scripts/check-promotion.sh" ]; then
  bash "$CANON/scripts/check-promotion.sh" --gate || exit $?
fi
# 3. no-postmortem doc gate (operational .claude/*.md)
if [ -f "$ROOT/.claude/hooks/no-postmortem-precommit.py" ]; then
  python3 "$ROOT/.claude/hooks/no-postmortem-precommit.py" || exit $?
fi
# 4. availability gate — every OPEN dependency owned by someone else must declare
#    [probed: …] / [decisional] / [NOT PROBED: …]. Override: PROBE_OK=1 git commit
if [ -f "$ROOT/scripts/check_dependency_probes.py" ] && [ -z "$PROBE_OK" ]; then
  python3 "$ROOT/scripts/check_dependency_probes.py" --staged || exit $?
fi
exit 0
