{
  "env": {
    "HOOK_SAFETY_LEVEL": "high",
    "CONFIG_GUARD_ALLOW": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pip:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git:*)",
      "Bash(pandoc:*)",
      "Bash(jq:*)",
      "Bash(echo:*)",
      "Bash(python3:*)",
      "Bash(head:*)",
      "Bash(cd:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(bash:*)",
      "Bash(cut:*)",
      "Bash(wc:*)",
      "Bash(printf:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "mcp__sequential-thinking__sequentialthinking"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=.claude/hooks/session-context.sh; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec bash \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"session-context.sh: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0"
          },
          {
            "type": "command",
            "command": "h=.claude/hooks/vendor/dead-rules-audit/dead-rules-audit.js; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec node \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec node \"$p/$h\"; p=$(dirname \"$p\"); done; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=scripts/check-permission-drift.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec python3 \"$p/$h\"; p=$(dirname \"$p\"); done; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "g=.claude/hooks/guard-resolve.sh; t=.claude/hooks/forked/guard-pack-redos-fix/guard-pack.js; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$g\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$g\" node \"$t\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$g\" ] && exec bash \"$p/$g\" node \"$t\"; p=$(dirname \"$p\"); done; echo \"GUARD BLOCKED: guard-resolve.sh not found from $PWD\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=.claude/hooks/guard-resolve.sh; t=.claude/hooks/vendor/smart-approve/smart_approve.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$g\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$g\" python3 \"$t\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$g\" ] && exec bash \"$p/$g\" python3 \"$t\"; p=$(dirname \"$p\"); done; echo \"GUARD BLOCKED: guard-resolve.sh not found from $PWD\" >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "h=.claude/hooks/kiss-yagni-reminder.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec python3 \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"kiss-yagni-reminder.py: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0"
          },
          {
            "type": "command",
            "command": "h=.claude/hooks/no-postmortem-validator.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec python3 \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"no-postmortem-validator.py: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0"
          },
          {
            "type": "command",
            "command": "h=.claude/hooks/availability-claim-validator.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec python3 \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec python3 \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"availability-claim-validator.py: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/gits/clybor-claude-tooling/scripts/check-public-text.py\"; [ -f \"$h\" ] && exec python3 \"$h\"; echo \"check-public-text.py: not found - HOOK SKIPPED (fails open)\" >&2; exit 0"
          }
        ]
      },
      {
        "matcher": "mcp__claude_ai_Gmail__(create_draft|update_draft|send_message|reply|forward)|mcp__notion__notion-(create-pages|update-page)|mcp__claude_ai_Zapier__execute_zapier_write_action",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/gits/clybor-claude-tooling/scripts/check-send-text.py\"; [ -f \"$h\" ] && exec python3 \"$h\"; echo \"check-send-text.py: not found - HOOK SKIPPED (fails open)\" >&2; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|WebFetch|Bash|Grep|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "h=.claude/hooks/vendor/prompt-injection-defender/post-tool-defender.py; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec uv run \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec uv run \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"post-tool-defender.py: not found from $PWD - HOOK SKIPPED (warn-only scanner, fails open by design)\" >&2; exit 0"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); echo \"$input\" | grep -qE 'CLAUDE\\.md|\\.claude/rules/' || exit 0; h=scripts/check-context-budget.sh; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$h\" 1>&2; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec bash \"$p/$h\" 1>&2; p=$(dirname \"$p\"); done; exit 0"
          },
          {
            "type": "command",
            "command": "h=.claude/hooks/vendor/format-code/format-code.js; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec node \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec node \"$p/$h\"; p=$(dirname \"$p\"); done; exit 0"
          },
          {
            "type": "command",
            "async": true,
            "command": "h=.claude/hooks/vendor/dead-rules-audit/dead-rules-audit.js; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec node \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec node \"$p/$h\"; p=$(dirname \"$p\"); done; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=.claude/hooks/vendor/dead-rules-audit/dead-rules-audit.js; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec node \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec node \"$p/$h\"; p=$(dirname \"$p\"); done; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "h=.claude/hooks/compact-recovery.sh; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec bash \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"compact-recovery.sh: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0",
            "statusMessage": "Re-injecting ROADMAP after compaction..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=.claude/hooks/ralph-stop.sh; [ -n \"$CLAUDE_PROJECT_DIR\" ] && [ -f \"$CLAUDE_PROJECT_DIR/$h\" ] && exec bash \"$CLAUDE_PROJECT_DIR/$h\"; p=\"$PWD\"; while [ \"$p\" != \"/\" ]; do [ -f \"$p/$h\" ] && exec bash \"$p/$h\"; p=$(dirname \"$p\"); done; echo \"ralph-stop.sh: not found from $PWD - HOOK SKIPPED (fails open by design)\" >&2; exit 0",
            "statusMessage": "Ralph loop hook checking state..."
          }
        ]
      }
    ]
  }
}
