{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pip:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git:*)",
      "Bash(pandoc:*)",
      "Bash(jq:*)",
      "mcp__sequential-thinking__sequentialthinking"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/kiss-yagni-reminder.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/compact-recovery.sh",
            "statusMessage": "Re-injecting ROADMAP after compaction..."
          }
        ]
      }
    ]
  }
}
