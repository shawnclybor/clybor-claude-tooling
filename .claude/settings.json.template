{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(pip:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(git:*)",
      "Bash(pandoc:*)",
      "Bash(jq:*)",
      "mcp__sequential-thinking__sequentialthinking"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/kiss-yagni-reminder.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/no-postmortem-validator.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "input=$(cat); if echo \"$input\" | grep -qE 'CLAUDE\\.md|\\.claude/rules/'; then bash scripts/check-context-budget.sh 1>&2; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/compact-recovery.sh",
            "statusMessage": "Re-injecting ROADMAP after compaction..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ralph-stop.sh",
            "statusMessage": "Ralph loop hook checking state..."
          }
        ]
      }
    ]
  }
}
