# Baseline .gitignore — scaffolded by clybor-claude-tooling/scripts/init.sh
# Add project-specific entries below the marked section.

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
npm-debug.log*

# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Backups produced by sed -i / init.sh
*.bak
*.bak-*

# Raw research capture: unreviewed source material, often large and often
# containing third-party or client content. Curated output lives in
# knowledge/wiki/ and IS tracked.
#
# Written as `dir/*` + a negation, NOT as `knowledge/raw/`. Git cannot re-include
# anything beneath an excluded DIRECTORY, so the `knowledge/raw/` form also swallows
# the .gitkeep — and the directory then vanishes on clone, which is the opposite of
# what init.sh's setup steps tell you to expect. Ignore the CONTENTS, keep the marker.
knowledge/raw/*
!knowledge/raw/.gitkeep

# Tooling
.skill-validator/
bundles/

# ---- project-specific ----
